diff --git a/innosrvkm/innodpu_connector.c b/innosrvkm/innodpu_connector.c
--- a/innosrvkm/innodpu_connector.c
+++ b/innosrvkm/innodpu_connector.c
@@ -2442,26 +2442,29 @@ int innodpu_get_connector_backlight_mode(inno_dev *dev, unsigned int reg_module)
 
 	version = fh2m_hal_hwinfo_version(pdev);
 	if (version < 0) {
-		fh2m_innodpu_err(dev, "hwinfo version failed, Use default DDCCI\n");
-		return CONNECTOR_BACKLIGHT_DDCCI;
+		fh2m_innodpu_err(dev, "hwinfo version failed, use PWM0 backlight fallback\n");
+		return CONNECTOR_BACKLIGHT_PWM0;
 	}
 
 	if (version >= 0x7) {
 		connector_id = innodpu_get_connector_id(pdev, reg_module);
 		if (connector_id < 0) {
-			fh2m_innodpu_err(dev, "connector_id failed, Use default DDCCI\n");
-			return CONNECTOR_BACKLIGHT_DDCCI;
+			fh2m_innodpu_err(dev, "connector_id failed, use PWM0 backlight fallback\n");
+			return CONNECTOR_BACKLIGHT_PWM0;
 		}
 
 		ret = fh2m_hal_get_backlight_mode(pdev, connector_id, &mode);
 		if (ret < 0) {
-			fh2m_innodpu_err(dev, "fh2m_hal_get_backlight_mode failed, Use default DDCCI\n");
-			mode = CONNECTOR_BACKLIGHT_DDCCI;
+			fh2m_innodpu_err(dev, "fh2m_hal_get_backlight_mode failed, use PWM0 backlight fallback\n");
+			mode = CONNECTOR_BACKLIGHT_PWM0;
 		}
 	} else {
-		mode = CONNECTOR_BACKLIGHT_DDCCI;
+		mode = CONNECTOR_BACKLIGHT_PWM0;
 	}
 
+	if (mode == CONNECTOR_BACKLIGHT_DDCCI)
+		mode = CONNECTOR_BACKLIGHT_PWM0;
+
 	conn_info(dev, "backlight_mode:%d\n", mode);
 
 	return mode;
 }
