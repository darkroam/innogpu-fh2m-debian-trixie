diff --git a/fantsrvkm/include/fantdpu_common.h b/fantsrvkm/include/fantdpu_common.h
--- a/fantsrvkm/include/fantdpu_common.h
+++ b/fantsrvkm/include/fantdpu_common.h
@@ -461,6 +461,9 @@
 #endif
 	bool display_enabled;
 	struct mutex init_lock;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+	struct mutex gem_lock;
+#endif
 
 	/* TBD: db9000 interface */
 
@@ -657,4 +660,23 @@
 	}
 	return fantdma_memcpy_for_smallbar(dev, srcs, dsts, lens, cnt, dir);
 }
+void *fantgpu_drm_to_display_private(struct drm_device *drm_dev);
+static inline void fantdpu_gem_lock(struct drm_device *dev)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+	struct fantdpu_drm_private *priv = fantgpu_drm_to_display_private(dev);
+	mutex_lock(&priv->gem_lock);
+#else
+	mutex_lock(&dev->struct_mutex);
+#endif
+}
+static inline void fantdpu_gem_unlock(struct drm_device *dev)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+	struct fantdpu_drm_private *priv = fantgpu_drm_to_display_private(dev);
+	mutex_unlock(&priv->gem_lock);
+#else
+	mutex_unlock(&dev->struct_mutex);
+#endif
+}
 #endif //__FANTDPU_COMMON_H
