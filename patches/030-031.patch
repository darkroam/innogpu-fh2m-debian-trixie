+static void fantgpu_pm_marker(struct device *dev, const char *stage,
+		const char *event, int rc, const char *mode, const char *reason,
+		int propagated, bool propagated_valid)
+{
+	if (propagated_valid)
+		dev_notice(dev, "fantgpu_pm_stage=%s event=%s rc=%d mode=%s reason=%s propagated=%d\n",
