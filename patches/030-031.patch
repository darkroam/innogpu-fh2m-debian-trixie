+			stage, event, rc, mode, reason);
+}
+
+static int fantgpu_pm_callback_result(struct device *dev, const char *mode,
+		int ret)
+{
+	int propagated = fantgpu_pm_propagate(ret);
+
+	if (ret)
+		fantgpu_pm_marker(dev, "pci_callback", "fail", ret, mode, "none",
+			propagated, true);
+	else
+		fantgpu_pm_marker(dev, "pci_callback", "done", ret, mode, "none", 0, true);
+	return propagated;
+}
