--- a/fantgpu/fant_timer.c
+++ b/fantgpu/fant_timer.c
@@ -157,7 +157,11 @@
 
 void fh2m_fant_timer_stop(struct fant_timer *fant_timer)
 {
+	#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 15, 0)
+	timer_delete_sync(&fant_timer->timer);
+#else
 	del_timer_sync(&fant_timer->timer);
+#endif
 }
 FANT_EXT_SYM(fh2m_fant_timer_stop);
 
