+#define FANTGPU_PM_PROBE_CONFIRM "confirm=R5_I4_DIAGNOSTIC"
+
+static void fantgpu_pm_probe_set_text(char *dest, const char *value)
+{
+	strscpy(dest, value, FANTGPU_PM_PROBE_TEXT_LEN);
+}
+
+static void fantgpu_pm_probe_marker(struct dev_rsrc *pdev_rsrc,
+		const char *probe, const char *step, const char *event,
+		int raw_rc, int normalized_rc)
+{
+	dev_warn(pdev_rsrc->dev,
+		"fantgpu_pm_probe=%s step=%s event=%s raw_rc=%d normalized_rc=%d\n",
+		probe, step, event, raw_rc, normalized_rc);
+}
+
+static void fantgpu_pm_probe_init(struct dev_rsrc *pdev_rsrc)
+{
+	struct fantgpu_pm_probe_state *probe = &pdev_rsrc->pm_probe;
+
+	mutex_init(&probe->lock);
+	probe->dentry = NULL;
+	probe->pm_transition = false;
+	probe->removing = false;
+	probe->used = false;
+	probe->running = false;
+	probe->raw_rc = 0;
+	probe->normalized_rc = 0;
+	fantgpu_pm_probe_set_text(probe->probe, "none");
+	fantgpu_pm_probe_set_text(probe->state, "idle");
+	fantgpu_pm_probe_set_text(probe->entered_step, "none");
+	fantgpu_pm_probe_set_text(probe->completed_step, "none");
+}
+
+static int fantgpu_pm_probe_file_get(struct file *file,
+		struct dev_rsrc **pdev_rsrc)
+{
+	int ret;
+
+	ret = debugfs_file_get(file->f_path.dentry);
+	if (ret)
+		return ret;
+	*pdev_rsrc = file->private_data;
+	if (!*pdev_rsrc) {
+		debugfs_file_put(file->f_path.dentry);
+		return -ENODEV;
+	}
+	return 0;
+}
+
+static ssize_t fantgpu_pm_probe_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	struct fantgpu_pm_probe_state *probe;
+	struct dev_rsrc *pdev_rsrc;
+	char status[256];
+	ssize_t ret;
+	int len;
+
+	ret = fantgpu_pm_probe_file_get(file, &pdev_rsrc);
+	if (ret)
+		return ret;
+	probe = &pdev_rsrc->pm_probe;
+	mutex_lock(&probe->lock);
+	len = scnprintf(status, sizeof(status),
+		"probe=%s\nstate=%s\nraw_rc=%d\nnormalized_rc=%d\n"
+		"entered_step=%s\ncompleted_step=%s\n",
+		probe->probe, probe->state, probe->raw_rc, probe->normalized_rc,
+		probe->entered_step, probe->completed_step);
+	mutex_unlock(&probe->lock);
+	ret = simple_read_from_buffer(buf, count, ppos, status, len);
+	debugfs_file_put(file->f_path.dentry);
+	return ret;
+}
+
+static ssize_t fantgpu_pm_probe_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	struct fantgpu_pm_probe_state *probe;
+	struct dev_rsrc *pdev_rsrc;
+	const char *probe_name;
+	char command[64];
+	bool monitor_cycle;
+	int sleep_rc = 0;
+	int wakeup_rc = 0;
+	int raw_rc;
+	int normalized_rc;
+	ssize_t ret;
+	size_t command_len = count;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (*ppos || !count || count >= sizeof(command))
+		return -EINVAL;
+	if (copy_from_user(command, buf, count))
+		return -EFAULT;
+	command[count] = '\0';
+	if (command_len && command[command_len - 1] == '\n')
+		command[--command_len] = '\0';
+	if (strchr(command, '\n'))
+		return -EINVAL;
+
+	if (!strcmp(command, "run reg-read " FANTGPU_PM_PROBE_CONFIRM)) {
+		probe_name = "reg-read";
+		monitor_cycle = false;
+	} else if (!strcmp(command, "run monitor-cycle " FANTGPU_PM_PROBE_CONFIRM)) {
+		probe_name = "monitor-cycle";
+		monitor_cycle = true;
+	} else {
+		return -EINVAL;
+	}
+
+	ret = fantgpu_pm_probe_file_get(file, &pdev_rsrc);
+	if (ret)
+		return ret;
+	probe = &pdev_rsrc->pm_probe;
+	ret = mutex_lock_interruptible(&probe->lock);
+	if (ret)
+		goto out_put;
+	if (READ_ONCE(probe->removing) || system_state != SYSTEM_RUNNING ||
+		probe->pm_transition || probe->used ||
+		fh2m_fant_rsrc_devres_find(pdev_rsrc->dev) != pdev_rsrc) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+
+	probe->used = true;
+	probe->running = true;
+	fantgpu_pm_probe_set_text(probe->probe, probe_name);
+	fantgpu_pm_probe_set_text(probe->state, "running");
+	fantgpu_pm_probe_set_text(probe->entered_step, "none");
+	fantgpu_pm_probe_set_text(probe->completed_step, "none");
+	probe->raw_rc = 0;
+	probe->normalized_rc = 0;
+
+	if (!monitor_cycle) {
+		fantgpu_pm_probe_set_text(probe->entered_step, "reg-read");
+		fantgpu_pm_probe_marker(pdev_rsrc, probe_name, "reg-read", "enter", 0, 0);
+		hal_check_reg_accessiable(pdev_rsrc);
+		fantgpu_pm_probe_set_text(probe->completed_step, "reg-read");
+		fantgpu_pm_probe_marker(pdev_rsrc, probe_name, "reg-read", "done", 0, 0);
+	} else {
+		fantgpu_pm_probe_set_text(probe->entered_step, "power_sleep");
+		fantgpu_pm_probe_marker(pdev_rsrc, probe_name, "power_sleep", "enter", 0, 0);
+		sleep_rc = hal_power_sleep(pdev_rsrc);
+		fantgpu_pm_probe_set_text(probe->completed_step, "power_sleep");
+		fantgpu_pm_probe_marker(pdev_rsrc, probe_name, "power_sleep",
+			sleep_rc ? "fail" : "done", sleep_rc,
+			fantgpu_pm_propagate(sleep_rc));
+
+		fantgpu_pm_probe_set_text(probe->entered_step, "power_wakeup");
+		fantgpu_pm_probe_marker(pdev_rsrc, probe_name, "power_wakeup", "enter", 0, 0);
+		wakeup_rc = hal_power_wakeup(pdev_rsrc);
+		fantgpu_pm_probe_set_text(probe->completed_step, "power_wakeup");
+		fantgpu_pm_probe_marker(pdev_rsrc, probe_name, "power_wakeup",
+			wakeup_rc ? "fail" : "done", wakeup_rc,
+			fantgpu_pm_propagate(wakeup_rc));
+	}
+
+	raw_rc = sleep_rc ? sleep_rc : wakeup_rc;
+	normalized_rc = fantgpu_pm_propagate(raw_rc);
+	probe->raw_rc = raw_rc;
+	probe->normalized_rc = normalized_rc;
+	probe->running = false;
+	fantgpu_pm_probe_set_text(probe->state,
+		normalized_rc ? "failed" : "returned");
+	ret = normalized_rc ? normalized_rc : count;
+
+out_unlock:
+	mutex_unlock(&probe->lock);
+out_put:
+	debugfs_file_put(file->f_path.dentry);
+	return ret;
+}
+
+static const struct file_operations fantgpu_pm_probe_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = fantgpu_pm_probe_read,
+	.write = fantgpu_pm_probe_write,
+	.llseek = default_llseek,
+};
+
+static void fantgpu_pm_probe_quiesce(struct dev_rsrc *pdev_rsrc)
+{
+	struct fantgpu_pm_probe_state *probe = &pdev_rsrc->pm_probe;
+
+	WRITE_ONCE(probe->removing, true);
+	if (probe->dentry) {
+		debugfs_remove(probe->dentry);
+		probe->dentry = NULL;
+	}
+	mutex_lock(&probe->lock);
+}
+
+static void fantgpu_pm_probe_release(struct dev_rsrc *pdev_rsrc)
+{
+	mutex_unlock(&pdev_rsrc->pm_probe.lock);
+	mutex_destroy(&pdev_rsrc->pm_probe.lock);
+}
+
+static int fantgpu_pm_transition_begin(struct device *dev,
+		struct dev_rsrc **pdev_rsrc)
+{
+	struct fantgpu_pm_probe_state *probe;
+
+	*pdev_rsrc = fh2m_fant_rsrc_devres_find(dev);
+	if (!*pdev_rsrc)
+		return -ENODEV;
+	probe = &(*pdev_rsrc)->pm_probe;
+	mutex_lock(&probe->lock);
+	if (READ_ONCE(probe->removing)) {
+		mutex_unlock(&probe->lock);
+		return -ENODEV;
+	}
+	probe->pm_transition = true;
+	return 0;
+}
+
+static void fantgpu_pm_transition_end(struct dev_rsrc *pdev_rsrc)
+{
+	pdev_rsrc->pm_probe.pm_transition = false;
+	mutex_unlock(&pdev_rsrc->pm_probe.lock);
+}
