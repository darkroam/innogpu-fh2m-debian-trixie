# Release artifacts are downloaded manually into debs/ (with root fallback for old scripts).
# They are required for local install/build, but must not be committed.
*.deb

# Generated by scripts/prepare-deepin-userspace-root.sh from the Deepin deb.
third_party/innogpu-fh2m-deepin-202504/

# Release/build artifacts are kept in debs/ locally but are never committed.
/debs/*
!/debs/README.md

# Local component builds are reproducible from scripts and source patches.
/.build/

# Keep only compact pass/fail markers from runtime baselines.
/baselines/latest-current-xorg-hwgl-test/*
!/baselines/latest-current-xorg-hwgl-test/result.txt
/baselines/latest-ddx-test/*
!/baselines/latest-ddx-test/result.txt

# Local runtime diagnostics can contain host paths, display cookies, and large logs.
/baselines/capability-survey-*.log
/baselines/runtime-baseline-*.txt
!/baselines/latest-runtime-baseline.txt
# Migrated black-box payload and staging build area (managed by binary-manifest.json + extractor).
/vendor/
/build/
# Driver-generated shader cache (appears when GL/Vulkan workloads run).
/.shaders/
/desktop-hwgl-*.txt
/post-reboot-hwgl-*.txt
/baselines/desktop-hwgl-*.txt
/ddx-vt-test-*.log
/ddx-test-*/
