#!/bin/sh

calls=${FAKE_XRANDR_CALLS:-/dev/null}
printf '%s\t%s\n' "$PPID" "$*" >> "$calls"

if [ "${FAKE_XRANDR_MODE:-fixture}" = fail ]; then
	exit 1
fi

sequence_dir=${FAKE_XRANDR_SEQUENCE_DIR:-}
sequence_state=${FAKE_XRANDR_SEQUENCE_STATE:-}

read_sequence_state() {
	state=0
	if [ -n "$sequence_state" ] && [ -r "$sequence_state" ]; then
		IFS= read -r state < "$sequence_state" || state=0
	fi
	case "$state" in
		''|*[!0-9]*) exit 2 ;;
	esac
}

advance_sequence() {
	event=$1
	[ -n "$sequence_dir" ] || return 0
	[ -n "$sequence_state" ] || exit 2
	transitions=$sequence_dir/transitions.tsv
	[ -r "$transitions" ] || return 0
	next_state=$(awk -F '\t' -v state="$state" -v event="$event" '
		$1 == state && ($2 == event || $2 == "read") {
			print $3
			exit
		}
	' "$transitions")
	[ -n "$next_state" ] || return 0
	case "$next_state" in
		*[!0-9]*) exit 2 ;;
	esac
	[ -r "$sequence_dir/$next_state.xrandr" ] || exit 2
	state_temp=$sequence_state.tmp.$$
	printf '%s\n' "$next_state" > "$state_temp" || exit 2
	mv "$state_temp" "$sequence_state" || exit 2
}

fixture_for_state() {
	if [ -n "$sequence_dir" ]; then
		[ -n "$sequence_state" ] || exit 2
		read_sequence_state
		fixture=$sequence_dir/$state.xrandr
	else
		fixture=${FAKE_XRANDR_FIXTURE:-}
	fi
	[ -r "$fixture" ] || exit 1
}

case "$*" in
	--current)
		fixture_for_state
		sed -n '1,$p' "$fixture"
		advance_sequence current
		;;
	--query|-q)
		fixture_for_state
		sed -n '1,$p' "$fixture"
		advance_sequence query
		;;
	*)
		printf '%s\n' "$*" >> "${FAKE_XRANDR_MUTATIONS:-/dev/null}"
		if [ -n "${FAKE_XRANDR_MUTATION_TIMES:-}" ]; then
			date +%s >> "$FAKE_XRANDR_MUTATION_TIMES"
		fi
		mutation_result=${FAKE_XRANDR_MUTATION_RESULT:-97}
		case "$mutation_result" in
			''|*[!0-9]*) exit 2 ;;
		esac
		if [ "$mutation_result" -eq 0 ]; then
			if [ -n "$sequence_dir" ]; then
				read_sequence_state
				advance_sequence mutation
			fi
		fi
		exit "$mutation_result"
		;;
esac
